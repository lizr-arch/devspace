{
  "manifest_version": 3,
  "name": "DevSpace Coach Watch (Paired Prototype)",
  "version": "0.2.0",
  "description": "Paired, read-only DevSpace review notifications. Never sends ChatGPT messages.",
  "permissions": [
    "alarms",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"},
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DevSpace review queue"
  },
  "side_panel": { "default_path": "panel.html" }
}
